    {
      "id": "example",
      "type": "text",
      "x": 588.5555555555557,
      "y": 1063.3333333333335,
      "width": 734.8818359375,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#666666",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
