      "roundness": null,
      "seed": 963513166,
      "version": 41,
      "versionNonce": 622717459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793848891928,
      "link": null,
      "locked": false,
      "text": "示例:D 刷新购物车 ×2 → 3 条 PV 只算 1 人;B 刷新确认页 ×5 → 5 条 PV 只算 1 人;跨夜再下单 → 新会话,不串入昨日漏斗",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "示例:D 刷新购物车 ×2 → 3 条 PV 只算 1 人;B 刷新确认页 ×5 → 5 条 PV 只算 1 人;跨夜再下单 → 新会话,不串入昨日漏斗",
      "lineHeight": 1.25,
      "index": "aU",
      "autoResize": true
    },
    {
      "id": "BAV3a6N0cBqDT75-nYawG",
      "type": "text",
      "x": 912.4615092045483,
      "y": -274.58418479944453,
      "width": 676.7999877929688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
